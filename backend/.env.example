PORT=3001
HOST=127.0.0.1
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# App database
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5433
AUTH_DB_NAME=telemed_app
AUTH_DB_USER=telemed
AUTH_DB_PASSWORD=telemed_pass

# eICU DB
EICU_DB_HOST=localhost
EICU_DB_PORT=5434
EICU_DB_NAME=eicu
EICU_DB_USER=eicu
EICU_DB_PASSWORD=eicu_pass

# MIMIC-IV DB
MIMIC_DB_HOST=localhost
MIMIC_DB_PORT=5435
MIMIC_DB_NAME=mimiciv
MIMIC_DB_USER=mimic
MIMIC_DB_PASSWORD=mimic_pass

# PICDB
PIC_DB_HOST=localhost
PIC_DB_PORT=5436
PIC_DB_NAME=picdb
PIC_DB_USER=pic
PIC_DB_PASSWORD=pic_pass

# Database pool
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# MIMIC schema config (comma-separated; affects query scope and search_path)
# MIMIC_SCHEMAS=mimiciv_hosp,mimiciv_icu
# MIMIC_DB_SEARCH_PATH=mimiciv_hosp,mimiciv_icu,public

# Jobs
# JOB_RUNNING_TIMEOUT_MINUTES=15

# Export limits (databases)
# EXPORT_BATCH_SIZE=5000
# EXPORT_MAX_BYTES=157286400
# EXPORT_MAX_XLSX_ROWS=1000000
# EXPORT_CSV_CHUNK_ROWS=2000
# EXPORT_XLSX_CHUNK_ROWS=2000

# S3 / MinIO
S3_BUCKET=telemed-storage
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Auth
JWT_SECRET=change_me_in_production
COOKIE_SECURE=false

# Upload
JSON_BODY_LIMIT=5mb
UPLOAD_MAX_FILE_SIZE=1073741824

# Support email (optional)
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=587
SUPPORT_SMTP_USER=
SUPPORT_SMTP_PASS=
SUPPORT_SMTP_SECURE=false
SUPPORT_TO_EMAIL=
SUPPORT_FROM_EMAIL=
SUPPORT_SMTP_CONNECTION_TIMEOUT=10000
SUPPORT_SMTP_GREETING_TIMEOUT=10000
SUPPORT_SMTP_SOCKET_TIMEOUT=10000
SUPPORT_SMTP_DNS_TIMEOUT=10000
SUPPORT_SMTP_TLS_SERVERNAME=
