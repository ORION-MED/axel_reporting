# App database
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5433
AUTH_DB_NAME=telemed_app
AUTH_DB_USER=telemed
AUTH_DB_PASSWORD=telemed_pass

# S3 / MinIO
S3_BUCKET=telemed-storage
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=jobs

# Worker
WORKER_ID=worker-1

# Parquet cache (optional)
# PARQUET_CACHE_MAX_AGE_HOURS=24
# PARQUET_CACHE_DIR=/tmp/staging_parquet

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
