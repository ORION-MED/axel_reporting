# Application
NODE_ENV=production
API_PREFIX=api
JWT_SECRET=
COOKIE_SECURE=true
CORS_ORIGINS=https://your-domain.example

# Frontend/Backend host ports (bound to localhost by docker-compose.server.yml)
FRONTEND_PORT=3000
BACKEND_PORT=3001
FRONTEND_HOST=127.0.0.1
BACKEND_HOST=127.0.0.1

# Frontend build-time variables
VITE_API_BASE_URL=/
# VITE_SUPPORT_PORTAL_URL=https://support.your-domain.example
# VITE_SUPPORT_KB_URL=https://support.your-domain.example/knowledgebase.php
# VITE_YANDEX_METRIKA_ID=

# App DB (auth/publications)
APP_DB_NAME=telemed_app
APP_DB_USER=telemed_app_user
APP_DB_PASSWORD=SuperSecurePassword123!
APP_DB_PORT=5433

# Admin seed (используется один раз при первом запуске, затем можно убрать)
SEED_ADMIN_PASSWORD=change_me_before_first_run

# eICU DB
EICU_DB_NAME=eicu
EICU_DB_USER=eicu_user
EICU_DB_PASSWORD=SuperSecurePassword987!
EICU_DB_PORT_EXTERNAL=5434

# MIMIC DB
MIMIC_DB_NAME=mimiciv
MIMIC_DB_USER=mimic_user
MIMIC_DB_PASSWORD=SuperSecurePassword456!
MIMIC_DB_PORT_EXTERNAL=5435
MIMIC_SCHEMAS=mimiciv_hosp,mimiciv_icu
MIMIC_DB_SEARCH_PATH=mimiciv_hosp,mimiciv_icu,public

# PICDB
PIC_DB_NAME=picdb
PIC_DB_USER=pic_user
PIC_DB_PASSWORD=SuperSecurePassword789!
PIC_DB_PORT_EXTERNAL=5436

# RabbitMQ
RABBITMQ_USER=telemed_rabbit
RABBITMQ_PASS=change_me_strong_rabbit_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_QUEUE=jobs

# Python worker
WORKER_ID=worker-1

# S3 storage (обязательно — используется для хранения публикаций и файлов воркера)
S3_BUCKET=telemed-storage
S3_REGION=us-east-1
# S3_ENDPOINT=          # оставьте пустым для AWS S3; для MinIO: http://minio:9000
S3_ACCESS_KEY=change_me_minio_access_key
S3_SECRET_KEY=change_me_strong_minio_secret_key
S3_FORCE_PATH_STYLE=true   # true для MinIO

# S3 multipart upload tuning
S3_PART_SIZE_MB=16
S3_QUEUE_SIZE=8
S3_MAX_SOCKETS=50

# Backend tuning
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000
JSON_BODY_LIMIT=5mb
UPLOAD_MAX_FILE_SIZE=1073741824

# Export limits (databases) — можно не задавать, используются дефолты
# EXPORT_BATCH_SIZE=5000
# EXPORT_MAX_BYTES=157286400
# EXPORT_MAX_XLSX_ROWS=1000000

# Jobs
# JOB_RUNNING_TIMEOUT_MINUTES=15

# Parquet cache (python-worker)
# PARQUET_CACHE_MAX_AGE_HOURS=24
# PARQUET_CACHE_DIR=/tmp/staging_parquet

# Logging: debug | verbose | info | warn | error
LOG_LEVEL=info
