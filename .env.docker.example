# Frontend/backend ports on host
FRONTEND_PORT=3000
BACKEND_PORT=3001

# App DB (auth + publications)
APP_DB_NAME=telemed_app
APP_DB_USER=telemed
APP_DB_PASSWORD=telemed_pass
APP_DB_PORT=5433

# eICU DB
EICU_DB_NAME=eicu
EICU_DB_USER=eicu
EICU_DB_PASSWORD=eicu_pass
EICU_DB_PORT_EXTERNAL=5434

# MIMIC-IV DB
MIMIC_DB_NAME=mimiciv
MIMIC_DB_USER=mimic
MIMIC_DB_PASSWORD=mimic_pass
MIMIC_DB_PORT_EXTERNAL=5435
MIMIC_SCHEMAS=mimiciv_hosp,mimiciv_icu
MIMIC_DB_SEARCH_PATH=mimiciv_hosp,mimiciv_icu,public

# PICDB
PIC_DB_NAME=picdb
PIC_DB_USER=pic
PIC_DB_PASSWORD=pic_pass
PIC_DB_PORT_EXTERNAL=5436

# S3 / MinIO object storage
S3_BUCKET=telemed-storage
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_QUEUE=jobs

# Python worker
WORKER_ID=worker-1

# Admin seed (используется один раз при первом запуске)
SEED_ADMIN_PASSWORD=change_me

# Backend security
JWT_SECRET=change_me_in_production
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PREFIX=api

# Backend tuning
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000
JSON_BODY_LIMIT=5mb
UPLOAD_MAX_FILE_SIZE=1073741824

# S3 multipart upload tuning
S3_PART_SIZE_MB=16
S3_QUEUE_SIZE=8
S3_MAX_SOCKETS=50

# Logging: debug | verbose | info | warn | error  (backend uses lowercase, worker uppercase — both accepted)
LOG_LEVEL=info
